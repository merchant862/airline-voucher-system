<% const c0 = customers?.[0] || {}; const c1 = customers?.[1] || {}; const h0 = hotels?.[0] || {}; const h1 = hotels?.[1] || {}; const h2 = hotels?.[2] || {}; const transport = transports?.[0] || {}; const headName = typeof familyHead !== 'undefined' ? familyHead : ''; const formatGender = (value) => /^female$/i.test(String(value || '')) ? 'F' : /^male$/i.test(String(value || '')) ? 'M' : String(value || ''); const nightsTotal = (hotels || []).reduce((sum, hotel) => sum + Number(hotel.nights || 0), 0); const formatRefDate = (value) => { if (!value) return ''; const date = new Date(value); if (Number.isNaN(date.getTime())) return String(value).replaceAll('/', '-'); return `${String(date.getDate()).padStart(2, '0')}-${date.toLocaleString('en-US', { month: 'short' }).toUpperCase()}-${String(date.getFullYear()).slice(-2)}`; }; const foreignName = (foreignCompany?.name || '').replace(/\\s*\\(PBT\\)\\s*$/i, ''); %>
