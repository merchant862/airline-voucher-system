<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Hotel Voucher <%= voucher.voucherNo %></title>
<style>
@page{size:A4 portrait;margin:10mm}*{box-sizing:border-box}body{margin:0;background:#fff;color:#2f3540;font-family:Arial,Helvetica,sans-serif;font-size:12px}.page{width:100%;max-width:900px;margin:0 auto}.header{height:158px;display:grid;grid-template-columns:34% 32% 34%;align-items:start;border-bottom:2px solid #d9dce1}.header-left{padding-top:7px}.header-center{text-align:center;padding-top:10px}.header-right{text-align:right;padding-top:12px}.title{font-size:31px;line-height:1.08;font-weight:800;letter-spacing:.2px}.voucher-no{margin-top:8px;font-size:21px;font-weight:700}.logo{width:190px;height:105px;object-fit:contain}.foreign-name{color:var(--theme-dark);font-size:14px;line-height:1.45;font-weight:800;text-transform:uppercase}.foreign-details{margin-top:7px;line-height:1.35}.facts{display:grid;grid-template-columns:1fr 1fr;margin-top:30px;min-height:132px}.fact-column{line-height:2.35}.fact-column.right{text-align:right;padding-right:12px}.fact-label{font-weight:800;margin-right:13px}.section{margin-top:14px;padding-bottom:7px;color:var(--theme-dark);border-bottom:2px solid #d9dce1;text-align:center;font-size:20px;font-weight:800}.data{width:100%;border-collapse:collapse;table-layout:fixed}.data th,.data td{padding:7px 8px;border-bottom:1px solid #d9dce1;text-align:left;vertical-align:middle;word-wrap:break-word}.data th{font-size:11px;font-weight:800}.data .name,.data .hotel{font-weight:700}.data .name,.data .hotel{color:var(--theme-dark)}.accommodation th,.accommodation td{text-align:left}.total{text-align:right;padding:9px 105px 0 0;font-weight:800}.transport td{padding-top:8px;padding-bottom:8px}.flight-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:15px}.flight-title{padding-bottom:7px;color:var(--theme-dark);border-bottom:2px solid #d9dce1;text-align:center;font-size:18px;font-weight:800}.flight th,.flight td{text-align:left}.notes{margin-top:29px;font-weight:600;line-height:1.5}.notes strong{color:#2f3540}.url{margin:28px 0 4px;color:var(--theme-dark);font-size:10px;text-align:center;text-decoration:underline;overflow-wrap:anywhere}.print{position:fixed;right:8px;bottom:8px;padding:7px 12px;border:2px solid var(--theme-primary);background:#fff;color:#9aa0a8;font-weight:700}@media print{.print{display:none}}@media(max-width:700px){body{font-size:10px}.header{height:120px}.title{font-size:22px}.voucher-no{font-size:16px}.logo{width:125px;height:75px}.foreign-name{font-size:10px}.facts{margin-top:18px}.section{font-size:16px}.flight-grid{gap:10px}.flight-title{font-size:14px}}
</style>
<style>
  .header { border-bottom-color:#d9dce1; }
  .header-left { padding-top:7px; }
  .header-center { padding-top:10px; }
  .header-right { padding-top:12px; }
  .logo { width:180px; height:96px; }
  .title { font-size:30px; }
  .voucher-no { font-size:21px; }
  .foreign-name { font-size:13px; }
</style>
<style>:root{--theme-primary:<%= theme.primary %>;--theme-dark:<%= theme.dark %>;--theme-soft:<%= theme.soft %>}</style>
<style>
  .pbt-name { color:var(--theme-dark); font-size:11px; line-height:1.35; font-weight:800; text-transform:uppercase; }
  .print { position:static; display:block; margin:8px auto 0; }
</style>
<style>
  @media (max-width:700px) {
    body { padding:0 12px; }
    .page { width:100%; max-width:none; }
    .header { grid-template-columns: minmax(0, 1fr) 92px minmax(0, 1fr); height:105px; }
    .header-left { padding-top:4px; }
    .header-center { padding-top:4px; }
    .header-right { padding-top:6px; min-width:0; }
    .logo { width:92px; height:54px; }
    .header-left .title { font-size:18px; line-height:1.05; }
    .header-left .voucher-no { margin-top:4px; font-size:14px; }
    .header-right .foreign-name,
    .header-right .pbt-name,
    .header-right .foreign-details { font-size:8px; line-height:1.2; overflow-wrap:anywhere; }
    .facts { grid-template-columns:1fr; min-height:0; gap:8px; }
    .fact-column { line-height:1.8; }
    .fact-column.right { padding-right:0; text-align:left; }
    .section { margin-top:10px; padding-bottom:5px; font-size:14px; }
    .data th, .data td { padding:5px 3px; font-size:9px; }
    .flight-grid { grid-template-columns:1fr; gap:14px; }
    .flight-title { font-size:14px; }
    .total { padding-right:0; }
    .notes { margin-top:18px; }
    .url { margin-top:18px; font-size:9px; }
  }
</style>
</head>
<body>
<main class="page">
  <% const foreignBaseName = (foreignCompany.name || '').replace(/\s*\(PBT\)\s*$/i, ''); %>
  <header class="header">
    <div class="header-left"><div class="title">HOTEL<br>VOUCHER</div><div class="voucher-no"><%= voucher.voucherNo || '' %></div></div>
    <div class="header-center"><% if(company.logo){ %><img class="logo" src="<%= company.logo %>" alt="Local company logo"><% } %></div>
    <div class="header-right"><div class="foreign-name"><%= foreignBaseName %></div><div class="pbt-name"><%= foreignBaseName %><% if(foreignBaseName){ %> (PBT)<% } %></div><div class="foreign-details"><%= foreignCompany.address || '' %><% if(foreignCompany.phone){ %><br><%= foreignCompany.phone %><% } %><% if(foreignCompany.email){ %><br><%= foreignCompany.email %><% } %></div></div>
  </header>
  <section class="facts">
    <div class="fact-column"><div><span class="fact-label">Passenger:</span><%= familyHead || customers[0]?.name || '' %></div><div><span class="fact-label">Voucher Date:</span><%= voucher.date || '' %></div><div><span class="fact-label">PAX:</span><%= customers.length %></div></div>
    <div class="fact-column right"><div><span class="fact-label">Local Company:</span><%= company.name || '' %></div><div><span class="fact-label">Foreign Company:</span><%= foreignCompany.name || '' %></div><div><span class="fact-label">Nights:</span><%= hotels.reduce((sum,hotel)=>sum+Number(hotel.nights||0),0) %></div></div>
  </section>
  <div class="section">Mutamers</div><table class="data"><tr><th>Passport</th><th>Passenger Name</th><th>Gender</th><th>PAX</th><th>Visa</th><th>PNR</th></tr><% customers.forEach(c=>{ %><tr><td><%= c.passport||'' %></td><td class="name"><%= c.name||'' %></td><td><%= c.gender||'' %></td><td><%= c.paxType||'' %></td><td><%= c.visaNumber||'' %></td><td><%= c.pnr||'' %></td></tr><% }) %></table>
  <div class="section">Accommodation</div><table class="data accommodation"><tr><th>Hotel Name</th><th>Room Type</th><th>Confirm #</th><th>Checkin</th><th>Checkout</th><th>Nights</th><th>Meal Plan</th></tr><% hotels.forEach(h=>{ %><tr><td class="hotel"><%= h.name||'' %></td><td><%= h.roomType||'' %></td><td><%= h.confirmNo||'' %></td><td><%= h.checkIn||'' %></td><td><%= h.checkOut||'' %></td><td><%= h.nights||0 %></td><td><%= h.mealPlan||'' %></td></tr><% }) %></table><div class="total">Total Nights: <%= hotels.reduce((sum,h)=>sum+Number(h.nights||0),0) %></div>
  <div class="section">Transport/Services</div><table class="data transport"><tr><th>Type</th><th>Route</th></tr><% transports.forEach(t=>{ %><tr><td><%= t.type||'' %></td><td><%= t.route||'' %></td></tr><% }) %></table>
  <div class="flight-grid"><div><div class="flight-title">Departure (Pakistan to KSA)</div><table class="data flight"><tr><th>Flight</th><th>Sector</th><th>Departure</th><th>Arrival</th></tr><tr><td><%= departureFlight.flightNo||'' %></td><td><%= departureFlight.fromCity||'' %> - <%= departureFlight.toCity||'' %></td><td><%= departureFlight.date||'' %> - <%= departureFlight.takeoff||'' %></td><td><%= departureFlight.date||'' %> - <%= departureFlight.landing||'' %></td></tr></table></div><div><div class="flight-title">Arrival (KSA to PAK)</div><table class="data flight"><tr><th>Flight</th><th>Sector</th><th>Departure</th><th>Arrival</th></tr><tr><td><%= arrivalFlight.flightNo||'' %></td><td><%= arrivalFlight.fromCity||'' %> - <%= arrivalFlight.toCity||'' %></td><td><%= arrivalFlight.date||'' %> - <%= arrivalFlight.takeoff||'' %></td><td><%= arrivalFlight.date||'' %> - <%= arrivalFlight.landing||'' %></td></tr></table></div></div>
  <div class="notes"><strong>Note:</strong> <%= notes || '—' %></div><div class="url" id="pageUrl"></div><button class="print" onclick="window.print()">Print</button>
</main><script>document.getElementById('pageUrl').textContent=window.location.href;</script>
</body></html>
