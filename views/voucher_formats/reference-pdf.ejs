<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Hotel Voucher <%= voucher.voucherNo %></title>
<style>
@page{size:A4 portrait;margin:4mm}*{box-sizing:border-box}body{margin:0;color:#111;font-family:Arial,Helvetica,sans-serif;font-size:8px}.voucher{width:100%}.header{display:grid;grid-template-columns:34% 32% 34%;align-items:start;min-height:80px;padding-bottom:3px}.header-left{padding:5px 0 0 4px}.header-center{text-align:center}.header-right{text-align:right;padding:4px 3px 0 0}.title{font-size:18px;line-height:1.03;font-weight:800}.voucher-no{margin-top:3px;color:var(--theme-dark);font-size:13px;font-weight:700}.logo{width:128px;height:57px;object-fit:contain}.foreign-name{font-size:9px;line-height:1.25;font-weight:800;text-transform:uppercase}.foreign-details{margin-top:2px;line-height:1.2}.info{width:100%;border-collapse:collapse;margin-top:2px}.info td{padding:3px 4px;border:2px solid #111;font-size:9px}.info .label{font-weight:800;white-space:nowrap}.band{margin-top:3px;padding:2px;border:2px solid #111;background:#d2d2d2;text-align:center;font-family:Georgia,serif;font-size:11px;font-weight:700}.data{width:100%;border-collapse:collapse;table-layout:fixed}.data th,.data td{padding:2px 3px;border:2px solid #111;text-align:center;vertical-align:middle;word-wrap:break-word}.data th{background:#d2d2d2;font-weight:700}.data .name,.data .hotel{font-weight:700}.data .name,.data .hotel{color:var(--theme-dark)}.accommodation td{border-style:dotted}.total{text-align:right;padding:2px 12px 0 0;font-weight:700;font-style:italic}.transport td{padding-top:3px;padding-bottom:3px}.flight-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px}.flight-title{padding:2px;border:2px solid #111;border-bottom:0;background:#d2d2d2;color:var(--theme-dark);text-align:center;font-family:Georgia,serif;font-size:10px;font-weight:700}.flight th,.flight td{padding:3px 3px}.bottom{display:grid;grid-template-columns:1fr 115px;gap:5px;align-items:start;margin-top:3px}.instructions{color:var(--theme-dark);font-size:9px;font-style:italic;font-weight:700}.notes{min-height:28px;font-style:italic;font-weight:700}.qr{text-align:center}.qr img{width:108px;height:108px;object-fit:contain}.contact-title{margin-top:5px;text-align:center;font-family:Georgia,serif;font-size:10px}.contact{width:100%;border-collapse:collapse;margin-top:3px}.contact td{padding:5px;border:2px solid #111;text-align:center;font-family:Georgia,serif;font-size:9px}.urdu{direction:rtl;text-align:right;margin:4px 0 0;padding:0 16px 0 0;font-family:'Voucher Nastaliq','Noto Nastaliq Urdu','Noto Naskh Arabic',Tahoma,sans-serif;font-size:8px;line-height:1.28}.urdu li{margin:0;padding-right:3px}
</style>
<style>@font-face{font-family:'Voucher Nastaliq';src:url('<%= urduFontData %>') format('truetype');font-weight:400}:root{--theme-primary:<%= theme.primary %>;--theme-dark:<%= theme.dark %>;--theme-soft:<%= theme.soft %>}</style>
</head>
<body><main class="voucher">
  <header class="header"><div class="header-left"><div class="title">HOTEL<br>VOUCHER</div><div class="voucher-no"><%= voucher.voucherNo||'' %></div></div><div class="header-center"><% if(company.logo){ %><img class="logo" src="<%= company.logo %>" alt="Local company logo"><% } %></div><div class="header-right"><div class="foreign-name"><%= foreignCompany.name||'' %></div><div class="foreign-details"><%= foreignCompany.address||'' %><% if(foreignCompany.phone){ %><br><%= foreignCompany.phone %><% } %><% if(foreignCompany.email){ %><br><%= foreignCompany.email %><% } %></div></div></header>
  <table class="info"><tr><td class="label">Passenger Name</td><td><%= familyHead||customers[0]?.name||'' %></td><td class="label">Voucher No</td><td><%= voucher.voucherNo||'' %></td><td class="label">Voucher Date</td><td><%= voucher.date||'' %></td></tr></table>
  <div class="band">Mutamers</div><table class="data"><tr><th>SNO</th><th>Passport</th><th>Passenger Name</th><th>Gender</th><th>PAX</th><th>Visa #</th><th>PNR</th></tr><% customers.forEach((c,i)=>{ %><tr><td><%= i+1 %></td><td><%= c.passport||'' %></td><td class="name"><%= c.name||'' %></td><td><%= c.gender||'' %></td><td><%= c.paxType||'' %></td><td><%= c.visaNumber||'' %></td><td><%= c.pnr||'' %></td></tr><% }) %></table>
  <div class="band">Accommodation</div><table class="data accommodation"><tr><th>City</th><th>Hotel Name</th><th>Meal</th><th>Confirm #</th><th>Room Type</th><th>Checkin</th><th>Checkout</th><th>Nights</th></tr><% hotels.forEach(h=>{ %><tr><td><%= h.city||'' %></td><td class="hotel"><%= h.name||'' %></td><td><%= h.mealPlan||'' %></td><td><%= h.confirmNo||'' %></td><td><%= h.roomType||'' %></td><td><%= h.checkIn||'' %></td><td><%= h.checkOut||'' %></td><td><%= h.nights||0 %></td></tr><% }) %></table><div class="total">Total Nights: <%= hotels.reduce((sum,h)=>sum+Number(h.nights||0),0) %></div>
  <div class="band">Transport/Services</div><table class="data transport"><tr><th>Type</th><th>Route</th></tr><% transports.forEach(t=>{ %><tr><td><%= t.type||'' %></td><td><%= t.route||'' %></td></tr><% }) %></table>
  <div class="flight-grid"><div><div class="flight-title">Departure (Pakistan to KSA)</div><table class="data flight"><tr><th>Flight</th><th>Sector</th><th>Departure</th><th>Arrival</th></tr><tr><td><%= departureFlight.flightNo||'' %></td><td><%= departureFlight.fromCity||'' %> - <%= departureFlight.toCity||'' %></td><td><%= departureFlight.date||'' %> - <%= departureFlight.takeoff||'' %></td><td><%= departureFlight.date||'' %> - <%= departureFlight.landing||'' %></td></tr></table></div><div><div class="flight-title">Arrival (KSA to PAK)</div><table class="data flight"><tr><th>Flight</th><th>Sector</th><th>Departure</th><th>Arrival</th></tr><tr><td><%= arrivalFlight.flightNo||'' %></td><td><%= arrivalFlight.fromCity||'' %> - <%= arrivalFlight.toCity||'' %></td><td><%= arrivalFlight.date||'' %> - <%= arrivalFlight.takeoff||'' %></td><td><%= arrivalFlight.date||'' %> - <%= arrivalFlight.landing||'' %></td></tr></table></div></div>
  <div class="bottom"><div><div class="instructions">Special Instructions:</div><div class="notes"><%= notes||'—' %></div></div><div class="qr"><img src="<%= qrImage %>" alt="Voucher QR code"></div></div>
  <div class="contact-title">SAUDI ARABIA TEAM CONTACT DETAILS</div><table class="contact"><tr><td>Local Company<br><%= company.name||'' %></td><td><%= company.phone||'' %></td></tr><tr><td>Foreign Company<br><%= foreignCompany.name||'' %></td><td><%= foreignCompany.phone||'' %></td></tr></table>
  <ul class="urdu"><li>آپ کا ہوٹل اور پیکیج اس دستاویز میں درج ہے، اسی کے مطابق آپ کو رہائش اور دیگر سہولیات فراہم کی جائیں گی۔</li><li>سفر کے دوران سامان مقررہ وزن کے مطابق ہونا چاہیے، اضافی سامان کی ادائیگی آپ کے ذمے ہوگی۔</li><li>پاسپورٹ اور ضروری دستاویزات محفوظ رکھیں اور سعودی عرب میں قیام کے دوران ہدایات پر عمل کریں۔</li><li>حرمین شریفین میں زیارت کے لیے مقررہ اوقات اور گروپ کی ہدایات کی پابندی کریں۔</li><li>جدہ ایئرپورٹ پر روانگی سے 3 تا 5 گھنٹے پہلے پہنچیں۔</li><li>ہوٹل چیک آؤٹ کا وقت دوپہر 2 بجے ہے، دیگر اوقات پیکیج کے مطابق ہوں گے۔</li><li>واپسی کی پرواز سے پہلے اپنے سامان سمیت ہوٹل کے ریسپشن پر موجود رہیں۔</li><li>سعودی حکومت اور کمپنی کے قوانین کی خلاف ورزی کے ذمے دار مسافر ہوں گے۔</li></ul>
</main></body></html>
