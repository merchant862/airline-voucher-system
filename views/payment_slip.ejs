<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Payment Slip</title>
<style>
@page { size:A4; margin:5mm; }
*{ box-sizing:border-box; }
body{ margin:0; font-family:Arial,Helvetica,sans-serif; color:#18212f; background:#fff; }
.slip{ width:100%; border:1px solid #cfd7e3; padding:10px 14px; }
.header{ display:grid; grid-template-columns:105px 1fr 155px; align-items:center; gap:10px; padding:10px; border-radius:8px; }
.logoBox{ width:88px; height:88px; background:#fff; border-radius:8px; display:flex; align-items:center; justify-content:center; padding:7px; box-shadow:0 6px 14px rgba(0,0,0,0.14); }
.logoBox img{ max-width:100%; max-height:100%; object-fit:contain; }
.brand h1{ margin:0; font-size:19px; line-height:1.15; letter-spacing:.3px; text-transform:uppercase; }
.brand .bar{ width:70px; height:3px; margin:6px 0 7px; border-radius:999px; }
.brand p{ margin:3px 0 0; font-size:9px; line-height:1.25; }
.receipt{ text-align:right; font-size:10px; line-height:1.6; }
.slip-qr{ display:block; width:90px; height:90px; margin:5px 0 0 auto; object-fit:contain; }
.title{ text-align:center; margin:10px 0 8px; font-size:18px; font-weight:800; letter-spacing:1px; color:#111827; }
.meta{ display:grid; grid-template-columns:1fr 1fr; gap:6px 16px; border:1px solid #d8e0eb; background:#f8fafc; padding:8px 10px; font-size:10px; }
.meta div{ display:flex; gap:8px; }
.meta span{ min-width:100px; font-weight:700; }
table{ width:100%; border-collapse:collapse; margin-top:10px; font-size:10px; }
th{ color:#fff; text-align:left; padding:6px 6px; }
td{ padding:6px; border:1px solid #d6dee9; }
td.num, th.num{ text-align:right; }
tbody tr:nth-child(even) td{ background:#fbfdff; }
.total{ margin-top:8px; display:flex; justify-content:flex-end; }
.totalBox{ width:250px; }
.totalRow{ display:flex; justify-content:space-between; padding:7px 9px; font-size:11px; border-bottom:1px solid #d6dee9; }
.totalRow:last-child{ border-bottom:0; font-size:13px; font-weight:800; }
.signatures{ display:grid; grid-template-columns:1fr 1fr; gap:45px; margin-top:38px; font-size:10px; }
.line{ border-top:1px solid #111827; padding-top:8px; text-align:center; }

.theme-meem .header{ background:linear-gradient(135deg,#0f172a,#1e293b 55%,#334155); border:1px solid #1e293b; }
.theme-meem .brand h1{ color:#fff; }
.theme-meem .brand p,.theme-meem .receipt{ color:#dbe4ee; }
.theme-meem .brand .bar{ background:#fbbf24; }
.theme-meem .receipt strong{ color:#fbbf24; }
.theme-meem .meta span{ color:#1e293b; }
.theme-meem th{ background:linear-gradient(135deg,#7c2d12,#c2410c); border:1px solid #7c2d12; }
.theme-meem .totalBox{ border:1px solid #7c2d12; }
.theme-meem .totalRow:last-child{ background:#fff7ed; color:#7c2d12; }

.theme-irfan .header{ border-bottom:3px solid #000; border-radius:0; }
.theme-irfan .brand h1,.theme-irfan .receipt strong,.theme-irfan .meta span{ color:#000; }
.theme-irfan .brand p,.theme-irfan .receipt{ color:#222; }
.theme-irfan .brand .bar,.theme-irfan th{ background:#000; }
.theme-irfan th{ border:1px solid #000; }
.theme-irfan .totalBox{ border:1px solid #000; }
.theme-irfan .totalRow:last-child{ background:#f4f4f4; color:#000; }

.theme-sudais .header{ border-bottom:3px solid #1f2937; border-radius:0; }
.theme-sudais .brand h1,.theme-sudais .receipt strong,.theme-sudais .meta span{ color:#1f2937; }
.theme-sudais .brand p,.theme-sudais .receipt{ color:#333; }
.theme-sudais .brand .bar,.theme-sudais th{ background:#1f2937; }
.theme-sudais th{ border:1px solid #1f2937; }
.theme-sudais .totalBox{ border:1px solid #1f2937; }
.theme-sudais .totalRow:last-child{ background:#f3f4f6; color:#1f2937; }

.theme-crm .header{ border-bottom:3px solid #0b6fa4; border-radius:8px; }
.theme-crm .brand h1,.theme-crm .receipt strong,.theme-crm .meta span{ color:#0b6fa4; }
.theme-crm .brand p,.theme-crm .receipt{ color:#4b5563; }
.theme-crm .brand .bar,.theme-crm th{ background:#0b6fa4; }
.theme-crm th{ border:1px solid #0b6fa4; }
.theme-crm .totalBox{ border:1px solid #0b6fa4; }
.theme-crm .totalRow:last-child{ background:#eef7fc; color:#0b6fa4; }
</style>
</head>
<body>
<style>
  .slip {
    --slip-primary:<%= slip.theme.primary %>;
    --slip-dark:<%= slip.theme.dark %>;
    --slip-soft:<%= slip.theme.soft %>;
  }
  .slip .header { border-bottom:3px solid var(--slip-dark) !important; background:var(--slip-primary) !important; }
  .slip .brand h1.agency-name { color:#000 !important; }
  .slip .brand p, .slip .receipt { color:var(--slip-dark) !important; }
  .slip .receipt strong { color:var(--slip-dark) !important; }
  .slip .meta span { color:var(--slip-dark) !important; }
  .slip .brand .bar, .slip th { background:var(--slip-dark) !important; }
  .slip th, .slip .totalBox { border-color:var(--slip-primary) !important; }
  .slip .totalRow:last-child { background:var(--slip-soft) !important; color:var(--slip-dark) !important; }
  .agency-name { color:#000 !important; }
</style>
<div class="slip theme-<%= slip.themeKey %>">
  <div class="header">
    <div class="logoBox">
      <% if (company.logo) { %><img src="<%= company.logo %>" alt="Company Logo"><% } %>
    </div>
    <div class="brand">
      <h1 class="agency-name">M/S <%= company.name %></h1>
      <div class="bar"></div>
      <% if (company.address) { %><p><%= company.address %></p><% } %>
      <% if (company.email) { %><p>Email: <%= company.email %></p><% } %>
      <% if (company.phone) { %><p>Phone: <%= company.phone %></p><% } %>
    </div>
    <div class="receipt">
      <div><strong>Receipt No:</strong> <%= slip.receiptNo %></div>
      <div><strong>Date:</strong> <%= slip.date %></div>
      <img class="slip-qr" src="<%= slip.qrImage %>" alt="Voucher QR code">
    </div>
  </div>

  <div class="title">PAYMENT SLIP</div>

  <div class="meta">
    <div><span>Voucher No:</span> <%= slip.voucherNo %></div>
    <div><span>Passenger Name:</span> <%= slip.passengerName %></div>
    <div><span>Saudi Company:</span> <span class="agency-name">M/S <%= foreignCompany.name %></span></div>
    <div><span>Currency:</span> <%= slip.currency %></div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Type</th>
        <th>Description</th>
        <th class="num">Qty</th>
        <th class="num">Rate</th>
        <th class="num">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% slip.items.forEach(item => { %>
        <tr>
          <td><%= item.category %></td>
          <td><%= item.description %></td>
          <td class="num"><%= item.quantity %> <%= item.quantityLabel %></td>
          <td class="num"><%= slip.currency %> <%= Number(item.rate).toLocaleString() %></td>
          <td class="num"><%= slip.currency %> <%= Number(item.amount).toLocaleString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="total">
    <div class="totalBox">
      <div class="totalRow"><span>Subtotal</span><span><%= slip.currency %> <%= Number(slip.totalAmount).toLocaleString() %></span></div>
      <div class="totalRow"><span>Total Amount</span><span><%= slip.currency %> <%= Number(slip.totalAmount).toLocaleString() %></span></div>
    </div>
  </div>

  <div class="signatures">
    <div class="line">Received By</div>
    <div class="line">Customer Signature</div>
  </div>
</div>
</body>
</html>
