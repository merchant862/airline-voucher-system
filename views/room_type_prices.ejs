<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Room Type Prices</title>
</head>
<body style="margin:0; font-family:Arial,sans-serif; background:linear-gradient(135deg,#141426,#1c1c3c); color:#fff;">
  <div style="width:100%; padding:16px 24px; background:#1e1e3d; border-bottom:3px solid #7b2ff7; box-sizing:border-box; display:flex; justify-content:space-between; align-items:center;">
    <a href="/dashboard" style="color:#fff; text-decoration:none; font-weight:bold;">Back to Dashboard</a>
    <h2 style="margin:0; color:#b388ff; font-size:20px;">Room Type Prices</h2>
    <a href="/logout" style="color:#fff; text-decoration:none; font-weight:bold;">Logout</a>
  </div>

  <div style="width:95%; max-width:900px; margin:28px auto;">
    <form method="POST" action="/room-type-prices" style="display:grid; grid-template-columns:1fr 1fr auto; gap:12px; background:#1e1e3d; border:1px solid #7b2ff7; border-radius:10px; padding:16px; box-sizing:border-box;">
      <select name="roomType" required style="padding:10px; border-radius:8px; border:1px solid #444; background:#2a2a50; color:#fff;">
        <option value="">Select room type</option>
        <option value="sharing">Sharing</option>
        <option value="quint">Quint</option>
        <option value="quad">Quad</option>
        <option value="triple">Triple</option>
        <option value="double">Double</option>
      </select>
      <input type="number" name="price" min="0" step="1" placeholder="Price" required style="padding:10px; border-radius:8px; border:1px solid #444; background:#2a2a50; color:#fff;">
      <button type="submit" style="padding:10px 16px; border:none; border-radius:8px; background:linear-gradient(90deg,#7b2ff7,#a855f7); color:#fff; font-weight:bold; cursor:pointer;">Save</button>
    </form>

    <div style="overflow-x:auto; margin-top:18px;">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="background:#1a1a35; color:#c77dff;">
            <th style="padding:12px; border:1px solid #444; text-align:left;">Room Type</th>
            <th style="padding:12px; border:1px solid #444; text-align:right;">Price</th>
            <th style="padding:12px; border:1px solid #444; text-align:left;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% prices.forEach(price => { %>
            <tr>
              <td style="padding:12px; border:1px solid #444; text-transform:capitalize;"><%= price.roomType %></td>
              <td style="padding:12px; border:1px solid #444; text-align:right;">PKR <%= Number(price.price || 0).toLocaleString() %></td>
              <td style="padding:12px; border:1px solid #444;">
                <form method="POST" action="/room-type-prices/delete/<%= price.id %>" style="display:inline;">
                  <button type="submit" style="border:none; background:none; color:#ff5252; font-weight:bold; cursor:pointer;">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (!prices.length) { %>
            <tr>
              <td colspan="3" style="padding:16px; border:1px solid #444; text-align:center; color:#bbb;">No prices configured</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>
