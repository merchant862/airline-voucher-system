<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Voucher List</title>
<style>
    .actions-dropdown {
        position: relative;
        display: inline-block;
    }

    .actions-dropdown summary {
        list-style: none;
        padding: 8px 12px;
        border-radius: 6px;
        background: #7b2ff7;
        color: #fff;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    .actions-dropdown summary::-webkit-details-marker {
        display: none;
    }

    .actions-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        min-width: 190px;
        background: #1a1a35;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 6px;
        z-index: 20;
        box-shadow: 0 10px 24px rgba(0,0,0,0.35);
    }

    .actions-menu a {
        display: block;
        padding: 8px 10px;
        border-radius: 6px;
        color: #fff;
        font-size: 13px;
        font-weight: bold;
        text-decoration: none;
    }

    .actions-menu a:hover {
        background: #2a2a50;
        color: #c77dff;
    }
</style>
</head>
<body style="
    margin:0;
    padding:0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #141426, #1c1c3c);
    color:#fff;
">

<!-- Top Total Vouchers with Generate Button -->
<div style="
    width:100%;
    padding:16px 24px;
    background:#1e1e3d;
    border-bottom:3px solid #7b2ff7;
    font-size:20px;
    font-weight:bold;
    color:#b388ff;
    box-sizing:border-box;
    display:flex;
    justify-content:space-between;
    align-items:center;
">
    <button onclick="logout()" style="
        padding:8px 16px;
        border:none;
        border-radius:8px;
        background: linear-gradient(90deg, #7b2ff7, #a855f7);
        color:#fff;
        font-weight:bold;
        cursor:pointer;
    ">Logout</button>

    <button onclick="generateVoucher()" style="
        padding:8px 16px;
        border:none;
        border-radius:8px;
        background: linear-gradient(90deg, #7b2ff7, #a855f7);
        color:#fff;
        font-weight:bold;
        cursor:pointer;
    ">Generate New Voucher</button>

    <button onclick="roomTypePrices()" style="
        padding:8px 16px;
        border:none;
        border-radius:8px;
        background: linear-gradient(90deg, #7b2ff7, #a855f7);
        color:#fff;
        font-weight:bold;
        cursor:pointer;
    ">Room Type Prices</button>
</div>

<!-- Stats Boxes -->
<div style="
    width:95%;
    max-width:1000px;
    margin:25px auto;
    display:flex;
    flex-wrap:wrap;
    gap:15px;
    justify-content:space-between;
">

<!-- Total -->
<div style="
    flex:1;
    min-width:180px;
    background:#1e1e3d;
    padding:10px;
    border-radius:12px;
    border:2px solid #7b2ff7;
    text-align:center;
    box-shadow:0 0 10px rgba(123,47,247,0.3);
">
    <h3 style="margin:0; color:#b388ff; font-size:16px;">
        Total Vouchers: <span id="totalVouchers">0</span>
    </h3>
</div>

<!-- Active -->
<div style="
    flex:1;
    min-width:180px;
    background:#1e1e3d;
    padding:10px;
    border-radius:12px;
    border:2px solid #00e676;
    text-align:center;
    box-shadow:0 0 10px rgba(0,230,118,0.3);
">
    <h3 style="margin:0; color:#00e676; font-size:16px;">
        Active Vouchers: <span id="totalActiveVouchers">0</span>
    </h3>
</div>

<!-- Inactive -->
<div style="
    flex:1;
    min-width:180px;
    background:#1e1e3d;
    padding:10px;
    border-radius:12px;
    border:2px solid #ff5252;
    text-align:center;
    box-shadow:0 0 10px rgba(255,82,82,0.3);
">
    <h3 style="margin:0; color:#ff5252; font-size:16px;">
        Inactive Vouchers: <span id="totalInactiveVouchers">0</span>
    </h3>
</div>

</div>

<!-- Table Container + Search -->
<div style="width:95%; max-width:1000px; margin:20px auto;">
    <div style="margin-bottom:12px; display:flex; justify-content:flex-end;">
        <input 
            type="text" 
            id="voucherSearch" 
            placeholder="Search voucher no or passenger name" 
            style="
                padding:8px 12px; 
                border-radius:8px; 
                border:1px solid #444; 
                background:#2a2a50; 
                color:#fff; 
                width:250px;
                box-sizing:border-box;
            "
        />
    </div>

    <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#1a1a35; color:#c77dff;">
                    <th style="padding:12px; border:1px solid #444; text-align:left;">Voucher No</th>
                    <th style="padding:12px; border:1px solid #444; text-align:left;">Passenger Name</th>
                    <th style="padding:12px; border:1px solid #444; text-align:left;">Voucher Date</th>
                    <th style="padding:12px; border:1px solid #444; text-align:left;">Voucher Status</th>
                    <th style="padding:12px; border:1px solid #444; text-align:left;">Action</th>
                </tr>
            </thead>
            <tbody id="voucherTableBody"></tbody>
        </table>
    </div>
</div>

<!-- Pagination -->
<div style="width:95%; max-width:1000px; margin:0 auto 40px auto; text-align:center;">
    <button onclick="prevPage()" style="padding:8px 12px; margin:4px; border-radius:6px; border:none; background:#7b2ff7; color:#fff; cursor:pointer;">Previous</button>
    <button onclick="nextPage()" style="padding:8px 12px; margin:4px; border-radius:6px; border:none; background:#7b2ff7; color:#fff; cursor:pointer;">Next</button>
</div>

<script>
// --------------------- VARIABLES ---------------------
let currentPage = 1;
const pageSize = 5;
let totalVouchers = 0;
let totalActiveVouchers = 0;
let totalInactiveVouchers = 0;

// --------------------- FETCH VOUCHERS ---------------------
async function fetchVouchers(page = 1, search = '') {
    try {
        const query = new URLSearchParams({
            page: page,
            search: search
        });

        const res = await fetch(`/api/dashboard?${query.toString()}`, {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        });

        const data = await res.json();

        if (!data.success) {
            return alert('Failed to fetch vouchers');
        }

        totalVouchers = data.totalVouchers;
        totalActiveVouchers = data.activeCount;
        totalInactiveVouchers = data.inactiveCount;

        renderTable(data.vouchers);
    } catch (err) {
        console.error(err);
        alert("Server error fetching vouchers");
    }
}

// --------------------- RENDER TABLE ---------------------
function escapeHtml(value) {
    return String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
}

function renderTable(vouchers) {
    const tbody = document.getElementById('voucherTableBody');
    tbody.innerHTML = '';

    vouchers.forEach(v => {
        const tr = document.createElement('tr');

        const statusColor = v.status === 'active' ? '#00e676' : '#ff5252';
        const statusText = v.status === 'active' ? 'ACTIVE' : 'INACTIVE';

        tr.innerHTML = `
            <td style="padding:12px; border:1px solid #444;">${escapeHtml(v.voucherNo)}</td>
            <td style="padding:12px; border:1px solid #444;">${escapeHtml(v.passengerName)}</td>
            <td style="padding:12px; border:1px solid #444;">${escapeHtml(v.voucherDate)}</td>
            <td style="padding:12px; border:1px solid #444; color:${statusColor}; font-weight:bold;">
                ${statusText}
            </td>
            <td style="padding:12px; border:1px solid #444;">
                <details class="actions-dropdown">
                    <summary>Actions</summary>
                    <div class="actions-menu">
                        <a href="/voucher/update/${v.id}">Edit</a>
                        <a href="/voucher/download/${v.id}">Download Voucher</a>
                        <a href="/voucher/payment-slip/${v.id}">Download Payment Slip</a>
                        <a target="_blank" href="/crm/data/voucher/hotel/travel/c=930390289898889s9ddcc0X9d0d90nsnwxweeddd&q=1909cnkxcjdsdudd9d9sd9sd9si9sdsdd/crm/data/voucher/hotel/travel/c=930390289898889s9ddcc0X9d0d90nsnwxweeddd&q=1909cnkxcjdsdudd9d9sd9sd9si9sdsdd/${v.id}">Link Voucher</a>
                        <a href="/api/voucher/update/active/${v.id}">Set active</a>
                        <a href="/api/voucher/update/inactive/${v.id}">Set inactive</a>
                    </div>
                </details>
            </td>
        `;

        tbody.appendChild(tr);
    });

    document.getElementById('totalVouchers').textContent = totalVouchers;
    document.getElementById('totalActiveVouchers').textContent = totalActiveVouchers;
    document.getElementById('totalInactiveVouchers').textContent = totalInactiveVouchers;

    if (vouchers.length === 0) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td colspan="5" style="padding:16px; border:1px solid #444; text-align:center; color:#bbb;">
                No vouchers found
            </td>
        `;
        tbody.appendChild(tr);
    }
}

// --------------------- SEARCH VOUCHER ---------------------
document.addEventListener('DOMContentLoaded', function() {
    const searchInput = document.getElementById('voucherSearch');

    if (searchInput) {
        let debounceTimer;

        searchInput.addEventListener('input', function() {
            clearTimeout(debounceTimer);

            debounceTimer = setTimeout(() => {
                currentPage = 1;
                fetchVouchers(currentPage, this.value.trim());
            }, 300);
        });
    }

    fetchVouchers(currentPage, '');
});

// --------------------- PAGINATION ---------------------
function prevPage() {
    const search = document.getElementById('voucherSearch').value.trim();

    if (currentPage > 1) {
        currentPage--;
        fetchVouchers(currentPage, search);
    }
}

function nextPage() {
    const search = document.getElementById('voucherSearch').value.trim();

    if (currentPage * pageSize < totalVouchers) {
        currentPage++;
        fetchVouchers(currentPage, search);
    }
}

// --------------------- BUTTON ACTIONS ---------------------
function generateVoucher() {
    window.location.assign('/voucher/create');
}

function roomTypePrices() {
    window.location.assign('/room-type-prices');
}

function logout() {
    window.location.href = '/logout';
}
</script>

</body>
</html>
